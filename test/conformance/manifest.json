{
  "poneyVersion": "0.1.0",
  "about": "Each file is a Poney document. A conforming reader accepts every valid file and rejects every invalid one. For invalid files it should report errors at each listed path (paths use dots and array indexes, as in JSON Pointer without the leading slash). Readers in other languages run this suite to prove conformance.",
  "cases": [
    {
      "file": "valid/minimal.poney",
      "valid": true,
      "rule": "\u00a73",
      "description": "Smallest document: three entities, two relationships, one view. Defaults fill the rest; missing styles are warnings."
    },
    {
      "file": "valid/sequence-with-fragments.poney",
      "valid": true,
      "rule": "\u00a75.6.1, \u00a76.2",
      "description": "Nested fragments; message ids unique within the interaction."
    },
    {
      "file": "valid/unknown-optional-extension.poney",
      "valid": true,
      "rule": "\u00a78.4",
      "description": "A reader that does not know an optional extension accepts the document, keeps the extension data and reports warnings."
    },
    {
      "file": "valid/walkthrough.poney",
      "valid": true,
      "rule": "\u00a75.8",
      "description": "A walkthrough with a mark, a focused scene and a callout."
    },
    {
      "file": "invalid/duplicate-entity-id.poney",
      "valid": false,
      "rule": "R1",
      "description": "Two entities share an id.",
      "errorPaths": [
        "model.entities.3.id"
      ]
    },
    {
      "file": "invalid/dangling-relationship.poney",
      "valid": false,
      "rule": "R3",
      "description": "A relationship points at an entity that does not exist.",
      "errorPaths": [
        "model.relationships.1.target"
      ]
    },
    {
      "file": "invalid/malformed-id.poney",
      "valid": false,
      "rule": "\u00a74",
