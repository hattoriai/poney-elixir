        {
          "id": "retry",
          "title": "The customer tries another card",
          "text": "A new endpoint takes a new card for an order in Payment failed. The order service checks the window first. Inside it, the payment path is the one checkout already uses. Outside it, the customer gets a clear answer instead of an error.",
          "risk": "look",
          "view": "retry-sequence",
          "focus": [],
          "callouts": [
            {
              "target": "message:payment-retry:r2",
              "text": "New endpoint on the gateway: POST /orders/:number/payment."
            },
            {
              "target": "message:payment-retry:r4",
              "text": "Checks the window and the count. A fourth try is refused here."
            },
            {
              "target": "message:payment-retry:r5",
              "text": "From here on, the same authorization as checkout."
            },
            {
              "target": "message:payment-retry:r14",
              "text": "410 Gone once the window closed: the order is already cancelled."
            }
          ],
          "cases": [
            {
              "when": "Window open, try 2 or 3",
              "then": "Authorize with the new card"
            },
            {
              "when": "Window closed",
              "then": "410, \"This order was cancelled\""
            },
            {
              "when": "Order already paid",
              "then": "409, nothing is charged",
              "note": "a double click on the form"
            }
          ],
          "proof": [
            {
              "text": "Retry inside the window pays the order",
              "source": "services/orders/internal/api/handlers_test.go",
              "missing": false
            },
            {
              "text": "Retry after the window returns 410",
              "source": "services/orders/internal/api/handlers_test.go",
              "missing": false
            },
            {
              "text": "A double submit charges once",
              "source": "services/orders/internal/api/handlers_test.go",
              "missing": false
            }
          ],
