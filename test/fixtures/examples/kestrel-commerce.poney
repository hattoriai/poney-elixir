    {
      "id": "kestrel-tour",
      "kind": "tour",
      "title": "A first walk through Kestrel",
      "summary": "The parts of Kestrel, and the path of one order from “Place order” to the confirmation email.",
      "source": {
        "kind": "Repository",
        "head": "3f9a2c1e8b7d",
        "repository": "kestrel/platform"
      },
      "story": {
        "text": "Kestrel is an online store: customers shop on the storefront, and the order service turns a cart into a paid order. Every other service does one job for it. This tour follows one order; it leaves out the back office, search and refunds."
      },
      "overview": "system-map",
      "verdict": {
        "risk": "routine",
        "facts": [
          {
            "label": "Languages",
            "value": "Go for orders and payments; Kotlin and TypeScript elsewhere"
          },
          {
            "label": "Run it",
            "value": "make dev starts every service and Postgres in Docker"
          },
          {
            "label": "Tests",
            "value": "make test; contract tests run against a fake Paystream"
          },
          {
            "label": "Read first",
            "value": "services/order/checkout/orchestrator.go"
          }
        ],
        "findings": [
          {
            "text": "Emails are sent from events, not from checkout: a slow event bus delays them, not the order.",
            "severity": "note",
            "scene": "t-checkout"
          }
        ]
      },
      "marks": [],
      "removed": {
        "entities": [],
        "relationships": [],
        "transitions": []
      },
