            "description": "argon2id hash. The password itself is never stored.",
            "primaryKey": false,
            "nullable": false,
            "unique": false
          },
          {
            "name": "display_name",
            "type": "text",
            "primaryKey": false,
            "nullable": false,
            "unique": false
          },
          {
            "name": "status",
            "type": "user_status",
            "description": "active, locked or closed.",
            "primaryKey": false,
            "nullable": false,
            "unique": false
          },
          {
            "name": "failed_attempts",
            "type": "smallint",
            "description": "Resets on a successful sign-in. Five locks the account.",
            "primaryKey": false,
            "nullable": false,
            "unique": false
          },
          {
            "name": "locked_until",
            "type": "timestamptz",
            "primaryKey": false,
            "nullable": true,
            "unique": false
          },
          {
            "name": "created_at",
            "type": "timestamptz",
            "primaryKey": false,
            "nullable": false,
            "unique": false
          }
        ],
