      {
        "id": "users",
        "kind": "table",
        "name": "users",
        "summary": "One row per customer account.",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "primaryKey": true,
            "nullable": false,
            "unique": false
          },
          {
            "name": "email",
