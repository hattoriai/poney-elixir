        {
          "id": "window",
          "title": "A worker gives the stock back when time runs out",
          "text": "Someone has to cancel the orders that nobody retries. A new worker runs every minute, finds orders whose window closed, cancels them, releases their stock and publishes OrderCancelled, so the email goes out as before.",
          "risk": "routine",
          "view": "retry-map",
          "focus": [
            "entity:retry-worker",
            "entity:order-db",
            "entity:inventory-service",
            "entity:event-bus",
            "relationship:r-retry-orderdb",
            "relationship:r-retry-inventory",
            "relationship:r-retry-eventbus"
          ],
          "callouts": [
            {
              "target": "entity:retry-worker",
              "text": "New. Runs every minute, one transaction per order."
            },
            {
              "target": "relationship:r-retry-inventory",
              "text": "The same release call that checkout made before."
            },
            {
              "target": "relationship:r-retry-eventbus",
              "text": "OrderCancelled, so the cancellation email is unchanged."
            }
          ],
          "cases": [
            {
              "when": "Window closed, status Payment failed",
              "then": "Cancel, release, publish"
            },
            {
              "when": "Customer paid one second before the run",
              "then": "Skipped: status is Paid",
              "note": "the update checks the status"
            }
          ],
          "proof": [
            {
              "text": "Expired orders are cancelled once",
              "source": "services/orders/internal/retrywindow/worker_test.go",
              "missing": false
            },
            {
              "text": "A paid order is never cancelled",
              "source": "services/orders/internal/retrywindow/worker_test.go",
              "missing": false
            }
          ],
