      {
        "id": "api-gateway",
        "kind": "gateway",
        "name": "API gateway",
        "summary": "One public entry point. Checks sessions and routes requests.",
        "description": "Terminates TLS, applies rate limits, asks the auth service to verify the session on every request, and forwards the call to the owning service.",
        "parent": "kestrel",
        "technology": "Envoy",
        "tags": [],
