      {
        "id": "order-service",
        "kind": "service",
        "name": "Order service",
        "summary": "Runs checkout and owns every order from start to delivery.",
        "description": "Orchestrates checkout: it validates the cart, reserves stock, asks for payment and confirms the order. It owns the order lifecycle and publishes order events through a transactional outbox.",
