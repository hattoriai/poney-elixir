      },
      {
        "id": "auth-service",
        "kind": "service",
        "name": "Auth service",
        "summary": "Signs customers in and keeps their sessions.",
        "description": "Stores accounts and password hashes, creates sessions, and verifies session tokens for the gateway. Active sessions are cached in Redis so verification takes under a millisecond.",
        "parent": "kestrel",
        "technology": "Go",
        "tags": [
          "security"
        ],
