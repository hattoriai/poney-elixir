      "scenes": [
        {
          "id": "lifecycle",
          "title": "A declined card no longer ends the order",
          "text": "Before, a decline went straight to Cancelled. Now it goes to a new state, Payment failed, where the order waits for another card. Three declines, or 30 minutes without a try, still cancel it.",
          "risk": "look",
          "view": "order-lifecycle",
          "focus": [
            "state:order-lifecycle:s-awaiting",
            "state:order-lifecycle:s-failed",
            "state:order-lifecycle:s-cancelled",
            "state:order-lifecycle:s-paid",
            "transition:order-lifecycle:t-declined",
            "transition:order-lifecycle:t-retry",
            "transition:order-lifecycle:t-give-up",
            "transition:order-lifecycle:t-decline-cancel",
            "transition:order-lifecycle:t-authorized"
          ],
          "callouts": [
            {
              "target": "transition:order-lifecycle:t-decline-cancel",
              "text": "Removed. The first decline cancelled the order here."
            },
            {
              "target": "transition:order-lifecycle:t-declined",
              "text": "A decline now moves the order to Payment failed."
            },
            {
              "target": "transition:order-lifecycle:t-retry",
              "text": "Each new card is one try. The order goes back to Awaiting payment."
            },
            {
              "target": "transition:order-lifecycle:t-give-up",
              "text": "After three tries, or 30 minutes, the order is cancelled as before."
            }
          ],
          "cases": [
            {
              "when": "The first card is declined",
              "then": "Payment failed, stock held",
              "note": "new"
            },
            {
              "when": "Another card is authorized within 30 minutes",
              "then": "Paid",
              "note": "same path as a first-time success"
            },
            {
              "when": "The third card is declined",
              "then": "Cancelled, stock released"
            },
            {
              "when": "30 minutes pass with no new card",
              "then": "Cancelled by the retry worker"
            }
          ],
          "proof": [
            {
              "text": "A decline moves Awaiting payment to Payment failed",
              "source": "services/orders/internal/domain/order_test.go",
              "missing": false
            },
            {
              "text": "A fourth try is refused",
              "source": "services/orders/internal/domain/order_test.go",
              "missing": false
            },
            {
              "text": "The third decline cancels and releases",
              "source": "services/orders/internal/domain/order_test.go",
              "missing": false
            },
            {
              "text": "A decline that arrives while the worker cancels the order",
              "missing": true
            }
          ],
          "question": "A retry charges the price frozen at checkout, even if the catalog price changed in the 30 minutes. Is that what you want?",
          "questions": [],
