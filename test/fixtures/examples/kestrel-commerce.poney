{
  "poneyVersion": "0.2.0",
  "project": {
    "id": "kestrel-commerce",
    "name": "Kestrel Commerce",
    "description": "An online store built from small services. Customers browse, fill a cart and check out; the platform reserves stock, takes payment through Paystream, and emails the customer. Operators manage products, stock and fulfilment from the back office.",
    "repository": "github.com/kestrel/commerce",
    "defaultView": "architecture"
  },
  "extensions": [
    {
      "name": "ownership",
      "version": "0.1.0",
      "required": false
    }
  ],
  "model": {
    "entities": [
      {
        "id": "customer",
        "kind": "person",
        "name": "Customer",
        "summary": "Browses the catalog, buys products and tracks orders.",
        "description": "Anyone shopping on the Kestrel storefront, signed in or not. Guests can browse and fill a cart; checkout needs an account.",
        "tags": [],
        "sourceRefs": [],
        "metadata": {},
        "ext": {}
      },
      {
        "id": "store-operator",
        "kind": "person",
        "name": "Store operator",
        "summary": "Runs the store: products, prices, stock and fulfilment.",
        "description": "Members of the operations team who work in the back office every day.",
        "tags": [],
        "sourceRefs": [],
        "metadata": {},
        "ext": {}
      },
      {
        "id": "kestrel",
        "kind": "system",
        "name": "Kestrel Commerce",
        "summary": "The online store: catalog, carts, checkout, payments and fulfilment.",
        "description": "A set of small services behind one API gateway. Each service owns its data. Services talk synchronously over gRPC for requests that need an answer now, and through the event bus for everything that can happen later.",
        "tags": [],
        "sourceRefs": [
          {
            "path": "README.md",
            "repository": "github.com/kestrel/commerce"
          }
        ],
        "metadata": {},
        "ext": {
          "ownership": {
            "team": "team-platform"
          }
        }
      },
